### 2. Frontend: Cálculos y Petición

#### [NEW] [chatbot.service.ts](file:///c:/Users/User/Desktop/Proyecto%20Final%20Henry/fastmoney-frontend/src/services/chatbot.service.ts)
El frontend toma las transacciones locales del usuario, las procesa por categoría y envía el resultado consolidado al proxy:

```typescript
import api from "./api";
import { Transaction } from "./transactions.service";

export interface ResumenConsolidado {
  nombreUsuario: string;
  ingresos: number;
  gastos: number;
  moneda: string;
  categorias: Record<string, number>;
}

export const chatbotService = {
  // Procesa la lista de transacciones que el frontend ya tiene cargada
  consolidarDatos: (transactions: Transaction[], userName: string): ResumenConsolidado => {
    let ingresos = 0;
    let gastos = 0;
    const categorias: Record<string, number> = {};
    const moneda = transactions[0]?.currency || "USD";

    transactions.forEach(t => {
      // Remover símbolos y signos para parsear el monto
      const cleanAmount = parseFloat(t.amount.replace(/[^\d.-]/g, ''));
      if (isNaN(cleanAmount)) return;

      if (t.type === "ENVIADO") {
        const absoluteAmount = Math.abs(cleanAmount);
        gastos += absoluteAmount;
        
        // Asignación de categorías (simuladas en base al título si no tiene campo explícito)
        let categoria = "Otros";
        const titleLower = t.title.toLowerCase();
        if (titleLower.includes("comida") || titleLower.includes("restaurante") || titleLower.includes("supermercado")) {
          categoria = "Alimentación";
        } else if (titleLower.includes("uber") || titleLower.includes("taxi") || titleLower.includes("nafta") || titleLower.includes("transporte")) {
          categoria = "Transporte";
        } else if (titleLower.includes("netflix") || titleLower.includes("cine") || titleLower.includes("juego") || titleLower.includes("entretenimiento")) {
          categoria = "Entretenimiento";
        } else if (titleLower.includes("luz") || titleLower.includes("agua") || titleLower.includes("alquiler") || titleLower.includes("servicio")) {
          categoria = "Servicios";
        }
        
        categorias[categoria] = (categorias[categoria] || 0) + absoluteAmount;
      } else if (t.type === "RECIBIDO" || t.type === "DEPOSITO") {
        ingresos += Math.abs(cleanAmount);
      }
    });

    return {
      nombreUsuario: userName,
      ingresos,
      gastos,
      moneda,
      categorias
    };
  },

  enviarParaAnalisis: async (datos: ResumenConsolidado): Promise<string> => {
    try {
      const response = await api.post("/api/chatbot/analizar", datos);
      return response.data.analisis;
    } catch (error) {
      console.warn("Backend no disponible o error. Usando respuesta mock local.");
      return `Hola ${datos.nombreUsuario}, registraste ingresos por $${datos.ingresos.toLocaleString()} y gastos por $${datos.gastos.toLocaleString()}. Tu mayor gasto fue en Alimentación (50%). Te recomiendo reducir gastos en Entretenimiento.`;
    }
  }
};
```

