generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id             Int      @id @default(autoincrement())
  nombre         String   @db.VarChar(100)
  apellido       String   @db.VarChar(100)
  email          String   @unique @db.VarChar(150)
  hashContrasena String   @db.VarChar(255)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cuenta         Cuenta?

  @@map("Usuarios")
}

model Cuenta {
  id             Int      @id @default(autoincrement())
  usuarioId      Int      @unique
  codigoCuenta   String   @unique @db.VarChar(36)
  monedaBase     String   @default("USD") @db.VarChar(10)
  activa         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  usuario                 Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  saldos                  SaldoPorMoneda?
  transferenciasEnviadas  Transferencia[]  @relation("TransferenciasEnviadas")
  transferenciasRecibidas Transferencia[]  @relation("TransferenciasRecibidas")
  metaAhorro              MetaAhorro?

  @@map("Cuentas")
}

model SaldoPorMoneda {
  id        Int      @id @default(autoincrement())
  cuentaId  Int      @unique
  usd       Decimal  @default(0) @db.Decimal(18, 2)
  eur       Decimal  @default(0) @db.Decimal(18, 2)
  ars       Decimal  @default(0) @db.Decimal(18, 2)
  cop       Decimal  @default(0) @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cuenta    Cuenta   @relation(fields: [cuentaId], references: [id], onDelete: Restrict)

  @@map("SaldosPorMoneda")
}

model MetaAhorro {
  id            Int      @id @default(autoincrement())
  cuentaId      Int      @unique
  nombre        String   @db.VarChar(200)
  limite        Decimal  @db.Decimal(18, 2)
  divisa        String   @db.VarChar(10)
  imagen        String?  @db.VarChar(500)
  saldoAhorrado Decimal  @default(0) @db.Decimal(18, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cuenta        Cuenta   @relation(fields: [cuentaId], references: [id], onDelete: Restrict)

  @@map("MetasAhorro")
}

model Transferencia {
  id              Int      @id @default(autoincrement())
  cuentaOrigenId  Int
  cuentaDestinoId Int
  moneda          String   @db.VarChar(10)
  monto           Decimal  @db.Decimal(18, 2)
  comision        Decimal  @db.Decimal(18, 2)
  createdAt       DateTime @default(now())

  cuentaOrigen  Cuenta @relation("TransferenciasEnviadas", fields: [cuentaOrigenId], references: [id], onDelete: Restrict)
  cuentaDestino Cuenta @relation("TransferenciasRecibidas", fields: [cuentaDestinoId], references: [id], onDelete: Restrict)

  @@map("Transferencias")
}
